# /etc/systemd/system/dump1090.service

[Unit]
Description=dump1090
After=multi-user.target

[Service]
User=root
ExecStart=/usr/local/bin/dump1090 --net
StandardOutput=null
Restart=no

# No [Install] section — dump1090 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start dump1090.service'.
