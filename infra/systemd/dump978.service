# /etc/systemd/system/dump978.service

[Unit]
Description=dump978
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-hyena-v2/bin/dump978.sh
StandardOutput=null
Restart=no

# No [Install] section — dump978 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start dump978.service'.
